{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":disableRateLimiting",
    ":automergeBranch",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits",
  ],
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      groupName: "linters",
      matchPackageNames: ["ruff", "mypy", "astral-sh/ruff-pre-commit"],
      automerge: true,
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
    {
      description: "A Python minor waits until Home Assistant supports it",
      matchManagers: ["mise"],
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
  ],
}
